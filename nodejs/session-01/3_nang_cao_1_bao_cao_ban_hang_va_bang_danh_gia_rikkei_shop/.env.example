# Sao chép tệp này thành .env rồi điền thông tin MySQL trên máy của bạn.
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rikkei_shop
# Cơ sở dữ liệu dùng khi chạy npm test. Tên PHẢI kết thúc bằng _test (test xóa và tạo lại bảng).
DB_NAME_TEST=rikkei_shop_test

JWT_SECRET=doi-chuoi-bi-mat-nay
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
API_KEY=rikkei-api-key
